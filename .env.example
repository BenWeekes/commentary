# OpenAI — used for translation (GPT-4o-mini)
OPENAI_API_KEY=sk-...

# Deepgram — STT (Nova-3)
DEEPGRAM_API_KEY=...

# ElevenLabs — TTS (WebSocket streaming)
ELEVENLABS_API_KEY=...

# Agora — real-time video/audio channel
AGORA_APP_ID=...
AGORA_APP_CERT=...

# Agora Cloud Recording — REST API auth (optional, enables channel recording)
AGORA_CUSTOMER_KEY=...
AGORA_CUSTOMER_SECRET=...

# Cloud Recording — S3 storage credentials (optional, used with cloud_recording config)
S3_ACCESS_KEY=...
S3_SECRET_KEY=...

# Sportradar — live match data API
SPORTRADAR_API_KEY=...
